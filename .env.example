# Required for Gemini-backed features
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Current default can be overridden if your account has a different available model.
GEMINI_MODEL=gemini-3.8-flash

# The project documentation specifies LaMini-Flan-T5 for local explanation.
# Keep false for an easier first run; set true after installing the local model dependencies.
USE_LOCAL_EXPLANATION=false
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M
